# ==========================================
# GuardianAI Backend Environment Variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.
# ==========================================

# --- App ---
APP_NAME=GuardianAI
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# SQLite for local dev. Swap for a Postgres URL later, e.g.
# postgresql+psycopg2://user:password@localhost:5432/guardianai
DATABASE_URL=sqlite:///./guardianai.db

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Email notifications (Phase 3) ---
# For Gmail: use an "App Password" (Google Account > Security > 2-Step
# Verification > App passwords), not your normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hiremathmegha09@gmail.com
SMTP_PASSWORD=zpmmkokizujkvstw
SMTP_FROM_EMAIL=hiremathmegha09@gmail.com

# --- Telegram (optional secondary channel, Phase 3) ---
# 1. Message @BotFather on Telegram, /newbot, copy the token below.
# 2. Add the bot to a group (or DM it), then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Escalation timing (Phase 3) ---
# Defaults are short (seconds) for live demo purposes. Use minutes-scale
# values (e.g. 300, 600) for anything resembling production.
ESCALATION_STEP1_DELAY_SECONDS=60
ESCALATION_STEP2_DELAY_SECONDS=120
ESCALATION_CHECK_INTERVAL_SECONDS=15

# --- Video/image upload (Phase 4) ---
# Paths are relative to the backend/ working directory.
UPLOAD_DIR=../data/uploads
EVIDENCE_DIR=../data/evidence
MAX_UPLOAD_SIZE_MB=100
